# Local self-host example. No accounts or passwords are preinstalled.
# Choose an existing folder with your own music; Compose mounts it read-only.
FMH_MUSIC_DIR=./music

# Public Dockerfile.family already supplies these safe defaults.
# ND_ENABLESHARING=false
# ND_ENABLEEXTERNALSERVICES=false
# ND_ENABLEINSIGHTSCOLLECTOR=false
# ND_DEFAULTTHEME=Nord

# Optional remote deployment: use your platform secret store for actual values.
# FMH_SETUP_TOKEN=YOUR_RANDOM_32_TO_96_CHARACTER_SETUP_SECRET
# FMH_BUNNY_BACKUPS=true
# BUNNY_STORAGE_ZONE=YOUR_ZONE
# BUNNY_STORAGE_PASSWORD=YOUR_PRIVATE_ZONE_WRITE_SECRET
# BUNNY_BACKUP_KEY_HEX=YOUR_PRIVATE_64_HEX_BACKUP_KEY
# Never commit a filled secret file or publish your server address.
